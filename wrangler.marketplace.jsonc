{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "communiverse-marketplace",
  "main": "worker/marketplace/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": true,
  "services": [
    { "binding": "LEGACY", "service": "communiverse" }
  ],
  "d1_databases": [
    { "binding": "COMMUNIVERSE_DB", "database_name": "communiverse-waitlist", "database_id": "6126080a-3d53-4043-baa5-3d2ebb4781bb", "migrations_dir": "worker/marketplace/migrations" }
  ]
}
